if test -f "$HOME/.nix-profile/etc/profile.d/nix.sh"; then
  source $HOME/.nix-profile/etc/profile.d/nix.sh
fi

# Directories to be prepended to $PATH
declare -a dirs_to_prepend
dirs_to_prepend=(
  "/usr/local/bin"
  "/usr/bin"
  "/bin"
  "/usr/sbin/"
  "/sbin"
  "/usr/local/sbin"
  "/usr/local/sketchybar/bin"
  "/usr/local/git/bin"
  "/usr/local/go/bin"
  "/usr/local/mysql/bin"
  "/usr/local/"
  "$HOME/.local/bin"
  "$HOME/dotfiles/bin"
  "$HOME/go/bin"
  "$HOME/bin"
  "$HOME/.cargo/bin" # rust binaries
  "$HOME/.yarn/bin"
  "$HOME/work/arcanist/arcanist/bin"
  "$HOME/tools/arcanist/bin"
  "$HOME/tools/"
  "/usr/local/opt/bison/bin"
)

for dir in ${(k)dirs_to_prepend[@]}
do
  if [ -d ${dir} ]; then
    # If these directories exist, then prepend them to existing PATH
    PATH="${dir}:$PATH"
  fi
done

unset dirs_to_prepend
export PATH

# --- TODO nixify everything below here ---
# Source local extra (private) settings specific to machine if it exists
[ -f ~/.zsh.local ] && source ~/.zsh.local

# I want to be able to jump words
bindkey "^[[1;3C" forward-word
bindkey "^[[1;3D" backward-word

# Fix mouse scroll in SSH sessions
# Disable the default bindings that make scroll wheel navigate history
# This allows proper terminal scrollback instead
if [[ -n "$SSH_CONNECTION" ]] || [[ -n "$SSH_CLIENT" ]] || [[ -n "$SSH_TTY" ]]; then
  # In SSH sessions, ensure scroll works properly
  # Unbind keys that might be triggered by mouse scroll
  bindkey -r '^[[A' 2>/dev/null  # Unbind up
  bindkey -r '^[[B' 2>/dev/null  # Unbind down
  bindkey '^[[A' up-line-or-history    # Re-bind up arrow properly
  bindkey '^[[B' down-line-or-history  # Re-bind down arrow properly
fi

# Nix
if [ -e '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh' ]; then
  . '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh'
fi
# End Nix

# Set up homebrew PATH first (so ssh-agent finds the right one)
[ -f /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"

SSH_ENV="$HOME/.ssh/ssh-agent.env"

# Start the agent if it's not running
start_agent() {
  # Skip if ssh-agent isn't available
  command -v ssh-agent >/dev/null 2>&1 || return

  echo "Initializing new SSH agent..."
  mkdir -p -m 700 "$(dirname "$SSH_ENV")"
  ssh-agent -s > "$SSH_ENV"
  chmod 600 "$SSH_ENV"
  . "$SSH_ENV" > /dev/null

  if command -v ssh-add >/dev/null 2>&1 && [ -f ~/.ssh/id_ed25519_sk_rk ]; then
    ssh-add ~/.ssh/id_ed25519_sk_rk
  fi
}

# Load the agent env if available and valid
if [ -f "$SSH_ENV" ]; then
  . "$SSH_ENV" > /dev/null
  kill -0 $SSH_AGENT_PID 2>/dev/null || start_agent
else
  start_agent
fi

export GPG_TTY=$(tty)
command -v gpg-connect-agent >/dev/null 2>&1 && gpg-connect-agent updatestartuptty /bye >/dev/null 2>&1

command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh --disable-up-arrow)"

