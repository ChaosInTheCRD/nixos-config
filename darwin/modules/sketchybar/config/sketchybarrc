#!/usr/bin/env sh

# Sketchybar configuration with Rosé Pine theme.

# Load color palette and icons
source "$HOME/.config/sketchybar/colorpresets/custom-theme.sh"
source "$HOME/.config/sketchybar/icons.sh"



# Directories for items and plugins
ITEM_DIR="$HOME/.config/sketchybar/items"
PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

# --- Helper Process ---
# This is for the github plugin, we can leave it as is.
HELPER=git.felix.helper
killall helper 2>/dev/null
cd $HOME/.config/sketchybar/helper && make > /dev/null 2>&1
$HOME/.config/sketchybar/helper/helper $HELPER > /dev/null 2>&1 &

# --- Bar Appearance ---
sketchybar --bar \
           height=38 \
           position=top \
           sticky=off \
           margin=10 \
           color=$TRANSPARENT \
           display=main \
           notch_width=188 \
           padding_left=10 \
           padding_right=10

# --- Default Settings ---
sketchybar --default \
           icon.font="JetBrainsMono Nerd Font:Regular:14.0" \
           icon.color=$ICON_COLOR \
           label.font="JetBrainsMono Nerd Font:Regular:14.0" \
           label.color=$LABEL_COLOR \
           background.height=28 \
           background.corner_radius=8 \
           background.color=$ITEM_COLOR \
           padding_left=4 \
           padding_right=4 \
           label.padding_left=4 \
           label.padding_right=4 \
           icon.padding_left=4 \
           icon.padding_right=4

# --- Left Items ---

# Mission Control Space Indicators
SPACE_ICONS=("" "" "󰈹" "󰒱" "󰆟" "" "" "󰁥" "" "󰆟")
SPACES=()
for i in "${!SPACE_ICONS[@]}"; do
  sid=$(($i+1))
  SPACES+=("space.$sid")
  sketchybar --add space space.$sid left \
             --set space.$sid associated_space=$sid \
                              icon=${SPACE_ICONS[i]} \
                              icon.highlight_color=$PINK \
                              label.drawing=off \
                              script="$ITEM_DIR/space.sh" \
                              click_script="yabai -m space --focus $sid"
done

# Front App
sketchybar --add item front_app left \
           --set front_app script="$ITEM_DIR/front_app.sh" \
                           icon.drawing=off \
                           label.color=$WHITE \
           --subscribe front_app front_app_switched

# Days Until (tsdays)
sketchybar --add item days_until left \
           --set days_until update_freq=3600 \
                            icon=0 \
                            script="$ITEM_DIR/daysuntil.sh" \
                            icon.color=$LAVENDER

# Bracket for left items
sketchybar --add bracket left_bracket "${SPACES[@]}" front_app days_until \
           --set left_bracket background.color=$ITEM_COLOR \
                              background.corner_radius=8

# --- Right Items ---

# Rain Chart
sketchybar --add graph rain_chart right 100 \
           --set rain_chart update_freq=120 \
                            script="$ITEM_DIR/rain.sh" \
                            icon=󰖗 \
                            icon.color=$PINK \
                            icon.padding_left=10 \
                            background.drawing=on \
                            background.border_width=0 \
                            graph.color=$LAVENDER \
                            graph.fill_color=0x80E98074 \
                            graph.line_width=2 \
                            label.drawing=off

# Clock and Calendar
sketchybar --add item clock right \
           --set clock update_freq=10 \
                       script="$ITEM_DIR/clock.sh" \
                       icon=$CALENDAR \
                       icon.color=$LAVENDER \
                       click_script="sketchybar --set calendar popup.drawing=toggle" \
           --add item calendar popup.clock \
           --set calendar script="$PLUGIN_DIR/calendar.sh" \
                          background.color=$POPUP_BACKGROUND_COLOR \
                          background.corner_radius=8 \
                          padding_left=10 \
                          padding_right=10

# IP Address and Battery
sketchybar --add item ip_address right \
           --set ip_address script="$ITEM_DIR/ip_address.sh" \
                            update_freq=10 \
                            icon=󰖩 \
                            icon.color=$PINK \
                            click_script="open 'x-apple.systempreferences:com.apple.preference.network'" \
           --subscribe ip_address wifi_change \
           --add item battery right \
           --set battery script="$ITEM_DIR/battery.sh" \
                         icon.color=$LAVENDER \
                         update_freq=120 \
           --subscribe battery system_woke power_source_change

# Audio
sketchybar --add item audio right \
           --set audio script="$ITEM_DIR/audio.sh" \
                       icon.color=$PINK \
                       click_script="open 'x-apple.systempreferences:com.apple.preference.sound'"

# Bracket for right items
sketchybar --add bracket right_bracket rain_chart clock ip_address battery audio \
           --set right_bracket background.color=$ITEM_COLOR \
                               background.corner_radius=8

# --- Notch Gaps ---
# We add invisible gap items to push the left and right brackets away from the notch.
# The width is calculated to be half of the notch_width from the bar settings.
sketchybar --add item notch_gap left \
           --set notch_gap width=94 \
                           background.drawing=off

sketchybar --add item notch_gap_right right \
           --set notch_gap_right width=94 \
                               background.drawing=off

# --- Finalize ---
sketchybar --update

echo "Sketchybar 'Rosé Pine' theme loaded."
