#!/usr/bin/env bash
# Put an issue onto the Kubernetes & Containers board, refined and visible
# in the working kanban view (label:Refined, milestone, status, not Meta).
# Mac-side only: needs the real authenticated gh, not the VM's maintner gh.
#
# usage: refine <issue-ref> [--milestone <m>] [--status <s>] [--type <t>]
#               [--priority <p>] [--no-label]
#        refine corp#45571
#        refine tailscale#16047 --priority High --type Bug
#   defaults: label Refined, status "Not Started", milestone from BOARD_ARGS
#   in ~/.config/llm-vm/env (falls back to none). --no-label skips Refined.
#
# gh project commands need the project scope: gh auth refresh -s project
set -euo pipefail
. "$(dirname "$0")/_llm-lib.sh"

MILESTONE=$(printf '%s' "${BOARD_ARGS:-}" | sed -n 's/.*--milestone \([^ ]*\).*/\1/p')
STATUS="Not Started" TYPE="" PRIORITY="" ADD_LABEL=1 REF=""
while [ $# -gt 0 ]; do
    case "$1" in
        --milestone) MILESTONE="$2"; shift ;;
        --status) STATUS="$2"; shift ;;
        --type) TYPE="$2"; shift ;;
        --priority) PRIORITY="$2"; shift ;;
        --no-label) ADD_LABEL=0 ;;
        -h|--help) sed -n '2,13p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) REF="$1" ;;
    esac
    shift
done
[ -n "$REF" ] || { echo "usage: refine <issue-ref> [--milestone m] [--status s] [--type t] [--priority p]" >&2; exit 1; }
parse_issue_ref "$REF"
URL="https://github.com/$REPO/issues/$NUM"

GH_STATUS=$(gh auth status 2>&1 || true)
case "$GH_STATUS" in
    *maintner*|*sandboxed*)
        echo "refine: this needs the real gh (run from your Mac, not the VM)" >&2; exit 1 ;;
esac

# --- issue-level fields: label, milestone, type -----------------------------
EDIT_ARGS=()
[ "$ADD_LABEL" -eq 1 ] && EDIT_ARGS+=(--add-label Refined)
[ -n "$MILESTONE" ] && EDIT_ARGS+=(--milestone "$MILESTONE")
if [ ${#EDIT_ARGS[@]} -gt 0 ]; then
    echo "==> $REPO#$NUM: ${EDIT_ARGS[*]}"
    gh issue edit "$NUM" --repo "$REPO" "${EDIT_ARGS[@]}" >/dev/null
fi

if [ -n "$TYPE" ]; then
    echo "==> setting issue type: $TYPE"
    TYPE_ID=$(gh api graphql -f query='query($owner:String!,$repo:String!){repository(owner:$owner,name:$repo){issueTypes(first:20){nodes{id name}}}}' \
        -f owner="${REPO%/*}" -f repo="${REPO#*/}" \
        --jq ".data.repository.issueTypes.nodes[] | select(.name == \"$TYPE\") | .id")
    if [ -z "$TYPE_ID" ]; then
        echo "refine: WARN: issue type '$TYPE' not found in $REPO; skipping" >&2
    else
        ISSUE_ID=$(gh api "repos/$REPO/issues/$NUM" --jq .node_id)
        gh api graphql -f query='mutation($issue:ID!,$type:ID!){updateIssue(input:{id:$issue,issueTypeId:$type}){issue{id}}}' \
            -f issue="$ISSUE_ID" -f type="$TYPE_ID" >/dev/null
    fi
fi

# --- project: add item, set Status (and Priority) ---------------------------
echo "==> adding to project $BOARD_PROJECT"
ITEM_ID=$(gh project item-add "$BOARD_PROJECT" --owner tailscale --url "$URL" --format json --jq .id)

PROJECT_ID=$(gh project view "$BOARD_PROJECT" --owner tailscale --format json --jq .id)
FIELDS=$(gh project field-list "$BOARD_PROJECT" --owner tailscale --format json)

set_single_select() { # $1=field-name $2=option-name
    local fid oid
    fid=$(echo "$FIELDS" | jq -r ".fields[] | select(.name == \"$1\") | .id")
    [ -n "$fid" ] || { echo "refine: WARN: no '$1' field on project; skipping" >&2; return 0; }
    oid=$(echo "$FIELDS" | jq -r ".fields[] | select(.name == \"$1\") | .options[] | select(.name == \"$2\") | .id")
    if [ -z "$oid" ]; then
        echo "refine: WARN: '$2' is not an option of '$1'. Options:" >&2
        echo "$FIELDS" | jq -r ".fields[] | select(.name == \"$1\") | .options[].name" | sed 's/^/  /' >&2
        return 0
    fi
    echo "==> $1: $2"
    gh project item-edit --project-id "$PROJECT_ID" --id "$ITEM_ID" \
        --field-id "$fid" --single-select-option-id "$oid" >/dev/null
}

set_single_select Status "$STATUS"
[ -n "$PRIORITY" ] && set_single_select Priority "$PRIORITY"

echo "==> done: $URL"
