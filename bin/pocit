#!/usr/bin/env bash
# Spin up a POC-building agent on the LLM VM from a spec file.
#
# usage: pocit --file <spec.(md|txt|docx|rtf)> [--project <new-name> | --repo <existing>]
#              [--provider <p>] [--ws-title <title>]
#   --project  create a fresh git repo at ~/Git/<new-name> on the VM and build there
#   --repo     build in an isolated worktree of an existing ~/Git/<repo>
#   (neither)  defaults to --project <spec filename slug>
#   --ws-title paseo workspace title (default: "poc <slug words>")
set -euo pipefail
. "$(dirname "$0")/_llm-lib.sh"

FILE="" PROJECT="" REPO="" PROVIDER="${TAKE_PROVIDER:-claude}" WS_TITLE=""
while [ $# -gt 0 ]; do
    case "$1" in
        --ws-title) WS_TITLE="$2"; shift ;;
        --file) FILE="$2"; shift ;;
        --file=*) FILE="${1#--file=}" ;;
        --project) PROJECT="$2"; shift ;;
        --project=*) PROJECT="${1#--project=}" ;;
        --repo) REPO="$2"; shift ;;
        --repo=*) REPO="${1#--repo=}" ;;
        --provider) PROVIDER="$2"; shift ;;
        -h|--help) sed -n '2,9p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
    shift
done
[ -n "$FILE" ] || { echo "usage: pocit --file <spec> [--project <name> | --repo <existing>]" >&2; exit 1; }
[ -f "$FILE" ] || { echo "error: no such file: $FILE" >&2; exit 1; }
[ -n "$PROJECT" ] && [ -n "$REPO" ] && { echo "error: --project and --repo are mutually exclusive" >&2; exit 1; }

# Spec to plain text (textutil is a macOS builtin; handles docx/doc/rtf)
case "$FILE" in
    *.docx|*.doc|*.rtf) SPEC=$(textutil -convert txt -stdout "$FILE") ;;
    *) SPEC=$(cat "$FILE") ;;
esac

slugify() { echo "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'; }
if [ -z "$PROJECT" ] && [ -z "$REPO" ]; then
    PROJECT=$(slugify "$(basename "${FILE%.*}")")
    echo "==> No --project/--repo given; creating new project '$PROJECT'"
fi

VMHOME=$(llm_ssh 'echo "$HOME"')
SLUG=$(slugify "${PROJECT:-$(basename "${FILE%.*}")}")
llm_ssh "mkdir -p ~/work/poc-$SLUG && [ -f ~/work/poc-$SLUG/LOG.md ] || echo '# Work log: poc-$SLUG' > ~/work/poc-$SLUG/LOG.md"
CONTEXT_FILE="work/poc-$SLUG/spec.md"
printf '%s\n' "$SPEC" | llm_ssh "cat > ~/$CONTEXT_FILE"

WS_TITLE="${WS_TITLE:-$(ws_title_from "poc $SLUG")}"
AGENT_ARGS=(run --background --provider "$PROVIDER" --title "poc: $SLUG")

if [ -n "$PROJECT" ]; then
    # Fresh repo on the VM; agent works directly in it (nothing to isolate from)
    llm_ssh "mkdir -p ~/Git/$PROJECT && cd ~/Git/$PROJECT && { [ -d .git ] || { git init -q -b main && git commit -q --allow-empty -m 'init'; }; }"
    WHERE="new repo ~/Git/$PROJECT"
    IFS=$'\t' read -r WS_ID WS_CWD < <(vm_workspace_create --isolation local \
        --path "$VMHOME/Git/$PROJECT" --title "$WS_TITLE")
else
    VM_REPO="Git/$(basename "$REPO")"
    WHERE="worktree of ~/$VM_REPO (branch chaosinthecrd/poc-$SLUG)"
    IFS=$'\t' read -r WS_ID WS_CWD < <(vm_workspace_create --isolation worktree \
        --path "$VMHOME/$VM_REPO" --title "$WS_TITLE" \
        --mode branch-off --new-branch "chaosinthecrd/poc-$SLUG" --worktree-slug "poc-$SLUG")
fi
[ -n "$WS_ID" ] || { echo "error: workspace creation failed" >&2; exit 1; }
AGENT_ARGS+=(--workspace "$WS_ID" --cwd "$WS_CWD")

PROMPT="Build a proof of concept. The full spec is in ~/$CONTEXT_FILE — read it first.

Ground rules:
- Work autonomously start to finish. Do NOT end your turn with questions for
  me — when something is ambiguous, pick the most reasonable interpretation,
  record it under 'Assumptions' in the design notes, and keep going.
- Scaffold the project properly (build tooling, deps, .gitignore).
- Make it RUN: execute it, fix it, iterate until it demonstrably works.
- README.md: what it is and exactly how to run it (committed — it belongs).
- Design decisions/assumptions/status/next steps: append to the shared work
  log as you go ('work log poc-$SLUG \"...\"'; extra files in ~/work/poc-$SLUG/),
  NOT committed to the repo.
- Commit as you go with clear messages. Do NOT push anywhere."

echo "==> Dispatching POC agent in $WHERE"
llm_ssh "export PATH=\"\$HOME/.nix-profile/bin:\$PATH\"; paseo $(printf '%q ' "${AGENT_ARGS[@]}") $(printf '%q' "$PROMPT")"
echo "==> Dispatched. Track with: paseo ls / attach via the app"
