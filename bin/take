#!/usr/bin/env bash
# Dispatch a GitHub issue to a paseo agent on the LLM VM. Pulls the issue
# (title/body/comments) via maintner, opens $EDITOR for your expectations,
# then starts a background agent in an isolated worktree on the VM.
#
# usage: take <issue-ref> [--repo-dir <vm-path>] [--provider <p>] [--no-notes]
#                         [--ws-title <title>]
#        take corp#45571
#        NOTES="just investigate" take corp#45571 --no-notes
# The paseo workspace title defaults to the first words of the issue title
# ("authkey reissuance"); override with --ws-title.
set -euo pipefail
. "$(dirname "$0")/_llm-lib.sh"

REF="" REPO_DIR_OVERRIDE="" PROVIDER="${TAKE_PROVIDER:-claude}" NO_NOTES=0 SHARE=0 WS_TITLE=""
while [ $# -gt 0 ]; do
    case "$1" in
        --repo-dir) REPO_DIR_OVERRIDE="$2"; shift ;;
        --provider) PROVIDER="$2"; shift ;;
        --ws-title) WS_TITLE="$2"; shift ;;
        --no-notes) NO_NOTES=1 ;;
        --share) SHARE=1 ;;
        -h|--help) sed -n '2,8p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) REF="$1" ;;
    esac
    shift
done
[ -n "$REF" ] || { echo "usage: take <issue-ref>" >&2; exit 1; }
parse_issue_ref "$REF"
REF="$REPO#$NUM"

echo "==> Fetching $REPO#$NUM from maintner"
ISSUE_JSON=$(maintner_query GetIssue "{\"repo\":\"$REPO\",\"number\":$NUM,\"comments\":true}")
TITLE=$(echo "$ISSUE_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["title"])')
echo "    $TITLE"

# Your expectations for the agent. The full issue (body + comments) is
# included as commented lines for reading; save with no uncommented content
# to ABORT (use --no-notes to dispatch without notes).
NOTES="${NOTES:-}"
if [ "$NO_NOTES" -eq 0 ] && [ -z "$NOTES" ]; then
    NOTES_FILE=$(mktemp /tmp/take-notes-XXXXXX.md)
    {
        cat <<EOF
# Notes for the agent working on $REPO#$NUM
# "$TITLE"
#
# Write your expectations below. Lines starting with # are stripped.
# Save with nothing else to CANCEL this take.
# ─────────────────────────── issue ───────────────────────────
EOF
        echo "$ISSUE_JSON" | python3 -c '
import json, sys, textwrap
d = json.load(sys.stdin)

def emit(text):
    for line in (text or "").splitlines() or [""]:
        for chunk in textwrap.wrap(line, 76) or [""]:
            print(f"# {chunk}")

author = d.get("author", {}).get("login", "?")
assignees = ",".join(a["login"] for a in d.get("assignees") or []) or "unassigned"
milestone = (d.get("milestone") or {}).get("title") or ""
print(f"# [author {author} | assigned: {assignees} | {milestone}]")
print("#")
emit(d.get("body"))
for c in d.get("comments") or []:
    print("#")
    cauthor = c.get("author", {}).get("login", "?")
    print(f"# -- comment by {cauthor} --")
    emit(c.get("body"))
'
    } > "$NOTES_FILE"
    ${EDITOR:-vim} "$NOTES_FILE"
    NOTES=$(grep -v '^#' "$NOTES_FILE" | sed -e '/./,$!d' || true)
    rm -f "$NOTES_FILE"
    if [ -z "$NOTES" ]; then
        echo "==> No notes written — cancelled (use --no-notes to dispatch without notes)."
        exit 0
    fi
fi

# Optionally share Mac-side kube contexts with the VM first (fzf multi-select)
CLUSTER_NOTE=""
if [ "$SHARE" -eq 1 ]; then
    share_clusters_note || exit 1
fi

# Where the agent works on the VM (default: ~/Git/<repo-basename>)
VMHOME=$(llm_ssh 'echo "$HOME"')
VM_REPO="${REPO_DIR_OVERRIDE:-$(vm_repo_dir "$REPO")}"
SLUG="issue-$NUM"
TITLE_SLUG=$(printf '%s' "$TITLE" | tr '[:upper:]' '[:lower:]' | tr -d "'" \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -d- -f1-5 | cut -c1-48 | sed 's/-*$//')
BRANCH="chaosinthecrd/${TITLE_SLUG:-$SLUG}"

# Shared work directory on the VM: ~/work/<slug>/ holds the issue payload,
# your expectations, and the append-only LOG.md every agent on this issue
# shares. Re-taking the same issue reuses the dir (and its accumulated log).
WORK_DIR="work/$SLUG"
llm_ssh "mkdir -p ~/$WORK_DIR && [ -f ~/$WORK_DIR/LOG.md ] || echo '# Work log: $REF' > ~/$WORK_DIR/LOG.md; echo '$REF' > ~/$WORK_DIR/ref; echo '~/$VM_REPO' > ~/$WORK_DIR/repo"
echo "$ISSUE_JSON" | llm_ssh "cat > ~/$WORK_DIR/issue.json"
[ -n "$NOTES" ] && printf '%s\n' "$NOTES" | llm_ssh "cat > ~/$WORK_DIR/expectations.md"

NOTES_BLOCK=""
if [ -n "$NOTES" ]; then
    NOTES_BLOCK=$(printf 'MY EXPECTATIONS (most important, follow these):\n%s\n' "$NOTES")
fi

PROMPT="You are working on GitHub issue $REPO#$NUM: \"$TITLE\".

Your shared work directory is ~/$WORK_DIR/ — read ALL of it first:
issue.json (full issue + comments), expectations.md (my instructions, if
present), and LOG.md (running log from every agent that has worked on this
issue — earlier findings, decisions, dead ends).
$CLUSTER_NOTE
$NOTES_BLOCK

Work autonomously start to finish — do NOT end your turn asking me questions.
If something is ambiguous, pick the most reasonable interpretation, record it
in the log, and keep going. Repos live at ~/Git/<repo>; clone missing ones
via https://github.com/tailscale/<repo> (auth is handled).

Approach:
1. Read the issue, LOG.md, and expectations carefully. Don't redo work the
   log shows is already done — build on it.
2. Investigate: find the relevant code, reproduce if feasible, identify root cause.
3. Record findings, decisions, assumptions, and dead ends by APPENDING to the
   log as you go: work log $SLUG \"<what you found/did>\". Substantial
   writeups can be separate files inside ~/$WORK_DIR/ — never inside the repo.
   NEVER commit notes/scratch files to the branch; commits must contain only
   changes that belong in an eventual PR.
4. Only implement the fix if you are confident in it; write tests for any code
   you change and run them. Before writing Go in k8s code (k8s-operator,
   containerboot, kube/), read ~/.claude_k8s_style.md and follow it — the
   user reviews every line you write against it.
5. Commit code changes to the branch with clear messages, and include this
   trailer line at the end of EVERY commit message so work can be traced even
   if branches are later renamed:
     Issue: $REF
   Do NOT push anywhere.
6. Finish with a summary entry in the log (work log $SLUG \"...\").

Useful here: 'gh issue view $REPO#$NUM' and 'gh' generally (read-only, maintner-backed,
no auth needed); private tailscale repos clone via plain github.com URLs (rogitproxy)."

WS_TITLE="${WS_TITLE:-$(ws_title_from "$TITLE")}"
echo "==> Creating workspace \"$WS_TITLE\" (worktree branch $BRANCH in ~/$VM_REPO)"
IFS=$'\t' read -r WS_ID WS_CWD < <(vm_workspace_create --isolation worktree \
    --path "$VMHOME/$VM_REPO" --title "$WS_TITLE" \
    --mode branch-off --new-branch "$BRANCH" --worktree-slug "$SLUG")
[ -n "$WS_ID" ] || { echo "error: workspace creation failed" >&2; exit 1; }

echo "==> Dispatching agent on $LLM_VM (workspace $WS_ID)"
AGENT_ARGS=(run --background
    --title "$REF: $TITLE"
    --label "issue=$REF"
    --workspace "$WS_ID" --cwd "$WS_CWD"
    --provider "$PROVIDER")

llm_ssh "export PATH=\"\$HOME/.nix-profile/bin:\$PATH\"; paseo $(printf '%q ' "${AGENT_ARGS[@]}") $(printf '%q' "$PROMPT")"
echo "==> Dispatched. Track with: taken"
