#!/usr/bin/env bash
# Dispatch a GitHub issue to a paseo agent on the LLM VM. Pulls the issue
# (title/body/comments) via maintner, opens $EDITOR for your expectations,
# then starts a background agent in an isolated worktree on the VM.
#
# usage: take <issue-ref> [--repo-dir <vm-path>] [--provider <p>] [--no-notes]
#        take corp#45571
#        NOTES="just investigate" take corp#45571 --no-notes
set -euo pipefail
. "$(dirname "$0")/_llm-lib.sh"

REF="" REPO_DIR_OVERRIDE="" PROVIDER="${TAKE_PROVIDER:-claude}" NO_NOTES=0
while [ $# -gt 0 ]; do
    case "$1" in
        --repo-dir) REPO_DIR_OVERRIDE="$2"; shift ;;
        --provider) PROVIDER="$2"; shift ;;
        --no-notes) NO_NOTES=1 ;;
        -h|--help) sed -n '2,8p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) REF="$1" ;;
    esac
    shift
done
[ -n "$REF" ] || { echo "usage: take <issue-ref>" >&2; exit 1; }
parse_issue_ref "$REF"
REF="$REPO#$NUM"

echo "==> Fetching $REPO#$NUM from maintner"
ISSUE_JSON=$(maintner_query GetIssue "{\"repo\":\"$REPO\",\"number\":$NUM,\"comments\":true}")
TITLE=$(echo "$ISSUE_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["title"])')
echo "    $TITLE"

# Your expectations for the agent
NOTES="${NOTES:-}"
if [ "$NO_NOTES" -eq 0 ] && [ -z "$NOTES" ]; then
    NOTES_FILE=$(mktemp /tmp/take-notes-XXXXXX.md)
    cat > "$NOTES_FILE" <<EOF
# Notes for the agent working on $REPO#$NUM
# "$TITLE"
# Lines starting with # are stripped. Save empty to skip.
EOF
    ${EDITOR:-vim} "$NOTES_FILE"
    NOTES=$(grep -v '^#' "$NOTES_FILE" | sed -e '/./,$!d')
    rm -f "$NOTES_FILE"
fi

# Where the agent works on the VM (default: ~/Git/<repo-basename>)
VMHOME=$(llm_ssh 'echo "$HOME"')
VM_REPO="${REPO_DIR_OVERRIDE:-$(vm_repo_dir "$REPO")}"
SLUG="issue-$NUM"
BRANCH="chaosinthecrd/$SLUG"

# Issue payload is written to a file on the VM rather than inlined in the
# prompt, to keep the paseo command line sane for big issues.
CONTEXT_FILE=".paseo-context-$SLUG.json"
echo "$ISSUE_JSON" | llm_ssh "cat > \"$CONTEXT_FILE\""

PROMPT="You are working on GitHub issue $REPO#$NUM: \"$TITLE\".

Full issue data (title, body, all comments) is in ~/$CONTEXT_FILE — read it first.

$([ -n "$NOTES" ] && printf 'MY EXPECTATIONS (most important, follow these):\n%s\n' "$NOTES")

Work autonomously start to finish — do NOT end your turn asking me questions.
If something is ambiguous, pick the most reasonable interpretation, record it
under 'Assumptions' in NOTES.md, and keep going. Repos live at ~/Git/<repo>;
clone missing ones via https://github.com/tailscale/<repo> (auth is handled).

Approach:
1. Read the issue and comments carefully. Read ~/eng-log.md if it exists.
2. Investigate: find the relevant code, reproduce if feasible, identify root cause.
3. Write your findings to NOTES.md in the worktree root: what you found, root
   cause, proposed fix, open questions.
4. Only implement the fix if you are confident in it; write tests for any code
   you change and run them.
5. Commit your work to the branch (NOTES.md included). Do NOT push anywhere.

Useful here: 'gh issue view $REPO#$NUM' and 'gh' generally (read-only, maintner-backed,
no auth needed); private tailscale repos clone via plain github.com URLs (rogitproxy)."

echo "==> Dispatching agent on $LLM_VM (worktree branch $BRANCH in ~/$VM_REPO)"
AGENT_ARGS=(run --background
    --title "$REF: $TITLE"
    --label "issue=$REF"
    --cwd "$VMHOME/$VM_REPO"
    --new-workspace worktree --worktree-mode branch-off
    --new-branch "$BRANCH" --worktree-slug "$SLUG"
    --provider "$PROVIDER")

llm_ssh "export PATH=\"\$HOME/.nix-profile/bin:\$PATH\"; paseo $(printf '%q ' "${AGENT_ARGS[@]}") $(printf '%q' "$PROMPT")"
echo "==> Dispatched. Track with: taken"
