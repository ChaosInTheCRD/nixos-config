#!/usr/bin/env bash
# Kubernetes & Containers project board (via maintner, read-only, no auth).
# Default: kanban-style view grouped into the board's status columns.
#
# usage: board [--unassigned] [--status <s>] [--label <l>] [--grep <pat>] [--limit N]
#              [--milestone <m>] [--no-epics] [--flat] [--json] [--raw]
#        board show <issue-ref>     full issue: description + comments
#   --unassigned   only items nobody is assigned to (the old default)
#   --status       single column (e.g. --status "In Progress")
#   --milestone    filter by milestone title (per-issue lookup; slower)
#   --no-epics     drop Epic-type items
#   --flat         old flat list (implies --status "Not Started" --unassigned
#                  unless overridden)
#   --raw          ignore BOARD_ARGS defaults from ~/.config/llm-vm/env
set -euo pipefail
. "$(dirname "$0")/_llm-lib.sh"

if [ "${1:-}" = "show" ]; then
    [ -n "${2:-}" ] || { echo "usage: board show <issue-ref>" >&2; exit 1; }
    parse_issue_ref "$2"
    maintner_query GetIssue "{\"repo\":\"$REPO\",\"number\":$NUM,\"comments\":true}" \
    | ISSUE_URL="https://github.com/$REPO/issues/$NUM" python3 -c '
import json, os, sys, textwrap

d = json.load(sys.stdin)

def wrap(text, indent=""):
    out = []
    for line in (text or "").splitlines() or [""]:
        out.extend(textwrap.wrap(line, 88, initial_indent=indent,
                   subsequent_indent=indent) or [indent.rstrip()])
    return "\n".join(out)

labels = ", ".join(l["name"] for l in d.get("labels") or []) or "-"
assignees = ", ".join(a["login"] for a in d.get("assignees") or []) or "unassigned"
milestone = (d.get("milestone") or {}).get("title") or "-"
state = d.get("state", "?")
title, url = d["title"], d.get("url") or os.environ.get("ISSUE_URL", "")

print(f"\033[1m{title}\033[0m")
print(url)
print(f"state: {state} | assigned: {assignees} | milestone: {milestone} | labels: {labels}")
print("─" * 88)
print(wrap(d.get("body")))
for c in d.get("comments") or []:
    author = c.get("author", {}).get("login", "?")
    print(f"\n\033[1m── comment by {author} ──\033[0m")
    print(wrap(c.get("body")))
'
    exit 0
fi

# BOARD_ARGS (from ~/.config/llm-vm/env) prepends personal default filters,
# e.g. BOARD_ARGS="--label Refined --milestone 1.104.0 --no-epics" to mirror
# a saved board view. --raw ignores it.
for a in "$@"; do [ "$a" = "--raw" ] && BOARD_ARGS=""; done
[ -n "${BOARD_ARGS:-}" ] && set -- $BOARD_ARGS "$@"

STATUS="" ONLY_UNASSIGNED=0 LABEL="" GREP="" LIMIT=0 JSON=0 FLAT=0 MILESTONE="" NO_EPICS=0
while [ $# -gt 0 ]; do
    case "$1" in
        --all) ;;  # legacy no-op: kanban view shows assigned items already
        --raw) ;;  # handled above
        --unassigned) ONLY_UNASSIGNED=1 ;;
        --status) STATUS="$2"; shift ;;
        --label) LABEL="$2"; shift ;;
        --grep) GREP="$2"; shift ;;
        --limit) LIMIT="$2"; shift ;;
        --milestone) MILESTONE="$2"; shift ;;
        --no-epics) NO_EPICS=1 ;;
        --flat) FLAT=1 ;;
        --json) JSON=1 ;;
        -h|--help) sed -n '2,15p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
    shift
done
if [ "$FLAT" -eq 1 ] && [ -z "$STATUS" ]; then STATUS="Not Started"; ONLY_UNASSIGNED=1; fi

maintner_query ListProjectItems "{\"owner\":\"tailscale\",\"project_number\":$BOARD_PROJECT}" \
| STATUS="$STATUS" ONLY_UNASSIGNED="$ONLY_UNASSIGNED" LABEL="$LABEL" GREP="$GREP" \
  LIMIT="$LIMIT" JSON="$JSON" FLAT="$FLAT" MILESTONE="$MILESTONE" NO_EPICS="$NO_EPICS" \
  MAINTNER_API="$MAINTNER_API" python3 -c '
import json, os, re, sys, urllib.request

items = json.load(sys.stdin)["items"]
status, label, grep = os.environ["STATUS"], os.environ["LABEL"], os.environ["GREP"]
only_unassigned = os.environ["ONLY_UNASSIGNED"] == "1"
limit, as_json = int(os.environ["LIMIT"]), os.environ["JSON"] == "1"
flat = os.environ["FLAT"] == "1"
milestone, no_epics = os.environ["MILESTONE"], os.environ["NO_EPICS"] == "1"

COLUMNS = ["Not Started", "In Progress", "In Review", "Done"]

out = []
for it in items:
    if it["is_pr"]:
        continue
    if no_epics and it.get("issue_type") == "Epic":
        continue
    if status:
        if it["status"] != status:
            continue
    elif it["status"] not in COLUMNS:
        continue  # Meta / not-on-board
    if only_unassigned and it.get("assignees"):
        continue
    labels = [l["name"] for l in it.get("labels") or []]
    if label and label not in labels:
        continue
    if grep and not re.search(grep, it["title"], re.I):
        continue
    out.append({"id": it["id"], "title": it["title"], "status": it["status"],
                "labels": labels, "url": it["url"], "updated_at": it.get("updated_at", ""),
                "assignees": [u.get("login","?") for u in it.get("assignees") or []]})

# Milestone is not in the project-items payload; look it up per surviving
# issue (concurrently). Filter-first keeps this to tens of requests, not
# the whole board.
if milestone:
    from concurrent.futures import ThreadPoolExecutor

    def issue_milestone(ref):
        repo, num = ref.rsplit("#", 1)
        body = json.dumps({"method": "GetIssue",
                           "params": {"repo": repo, "number": int(num)}}).encode()
        req = urllib.request.Request(os.environ["MAINTNER_API"], data=body,
                                     headers={"Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(req, timeout=15) as r:
                d = json.load(r)
            return (d.get("milestone") or {}).get("title") or ""
        except Exception:
            return ""

    with ThreadPoolExecutor(max_workers=8) as ex:
        ms = list(ex.map(issue_milestone, [i["id"] for i in out]))
    out = [i for i, m in zip(out, ms) if m == milestone]

out.sort(key=lambda i: i["id"])
if limit:
    out = out[:limit]

if as_json:
    json.dump(out, sys.stdout, indent=2); print()
    sys.exit(0)

def line(i):
    labs = ",".join(l for l in i["labels"] if l != "kubernetes") or "-"
    who = " @" + ",".join(i["assignees"]) if i["assignees"] else ""
    iid, ititle = i["id"], i["title"]
    return f"  {iid:26} [{labs}]{who} {ititle[:64]}"

if flat or status:
    for i in out:
        print(line(i))
    print(f"\n{len(out)} issues", file=sys.stderr)
    sys.exit(0)

DONE_CAP = 8
for col in COLUMNS:
    ci = [i for i in out if i["status"] == col]
    extra = ""
    if col == "Done":
        ci.sort(key=lambda i: i["updated_at"], reverse=True)
        if len(ci) > DONE_CAP:
            extra = f"  (showing {DONE_CAP} most recent)"
        ci = ci[:DONE_CAP]
    total = sum(1 for i in out if i["status"] == col)
    print(f"\033[1m── {col} ({total}){extra} " + "─" * max(0, 50 - len(col)) + "\033[0m")
    for i in ci:
        print(line(i))
    print()
print(f"{len(out)} issues on the board (board show <ref> for details)", file=sys.stderr)
'
